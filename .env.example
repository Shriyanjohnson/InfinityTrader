# Copy to .env on the deployment host. Never commit real keys.
PUBLIC_HOST=beta.example.com
INFINITY_PUBLIC_URL=https://beta.example.com
INFINITY_SUPPORT_EMAIL=support@example.com
INFINITY_MODE=beta
INFINITY_LIVE_DATA_ENABLED=1
INFINITY_MARKET_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
# Set only after obtaining a plan allowing public display/redistribution.
INFINITY_DATA_LICENSE_ACK=0
# Set only after adopting the beta terms, privacy, backup retention, and refund policy.
INFINITY_OPERATOR_TERMS_ACK=0
INFINITY_FREE_BETA=1
INFINITY_CHECKOUT_ENABLED=0
INFINITY_MAX_ACCOUNTS=200
INFINITY_WORKER_INTERVAL=900
# Optional headlines require a suitable public-use plan and explicit acknowledgement.
NEWSAPI_KEY=
INFINITY_NEWS_LICENSE_ACK=0
